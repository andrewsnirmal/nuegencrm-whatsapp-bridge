# Port this bridge listens on
PORT=3001

# Must match WHATSAPP_QR_BRIDGE_SECRET in the Laravel app's .env
BRIDGE_SECRET=change-this-to-a-long-random-string

# Base URL of the Laravel app, used to post incoming messages/status
# updates back via POST /webhooks/whatsapp/qr
LARAVEL_WEBHOOK_URL=https://yourdomain.com/webhooks/whatsapp/qr
